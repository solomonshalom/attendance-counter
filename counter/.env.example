# Counter service configuration. Copy to .env to customize.

# Camera source: integer index ("0", "1") or RTSP/HTTP URL.
COUNTER_SOURCE=0

# Inference device: auto | mps | cpu | cuda
COUNTER_DEVICE=auto

# YOLO model name (auto-downloaded). Fallback used if primary fails to load.
COUNTER_MODEL_NAME=yolo26n.pt
COUNTER_FALLBACK_MODEL_NAME=yolov8n.pt

# Detection thresholds.
COUNTER_CONFIDENCE=0.35
COUNTER_IOU=0.5
COUNTER_IMAGE_SIZE=640

# Capture resolution.
COUNTER_CAPTURE_WIDTH=1280
COUNTER_CAPTURE_HEIGHT=720
COUNTER_TARGET_FPS=30

# Mirror the preview horizontally (useful for selfie cams).
COUNTER_MIRROR=false

# Bind address.
COUNTER_HOST=127.0.0.1
COUNTER_PORT=8765
